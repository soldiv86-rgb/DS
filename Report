local BOT_REPORT_URL = "https://divine-souls-bot.onrender.com/report"
local REPORT_SECRET = "K9mP2xR7vL4qW8nJ3tY6hB1cF5zA0eD" -- must match the bot's REPORT_SECRET
local REPORT_INTERVAL = 60
local JITTER_SECONDS = 5 -- spreads multiple alts' reports out instead of all firing in the same instant
local CHANGE_POLL_SECONDS = 1 -- how often we check for a JobId/PlaceId/respawn event worth reporting early

-- No ACCOUNT_LABEL anymore - the account's identity IS its real Roblox
-- username/userId now, sent automatically below. Nothing to type per
-- account, and nothing to keep in sync if you rename an alt.

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")
local player = Players.LocalPlayer

-- Fetched ONCE at script start instead of on every report cycle. The game
-- name doesn't change mid-session, so calling GetProductInfo every 60s
-- forever was a wasted (and rate-limit-risking) API call per account.
local cachedGameName
do
	local ok, name = pcall(function()
		return MarketplaceService:GetProductInfo(game.PlaceId, Enum.InfoType.Asset).Name
	end)
	cachedGameName = ok and name or "Unknown"
end

-- Sends the report and returns true only if the BOT actually accepted it
-- (HTTP 2xx). A 401 (wrong secret) or 400 (malformed body) still counts as
-- a "successful request" at the network level, but the bot silently never
-- stored the account - checking the status code is what actually catches
-- that instead of the account quietly going "offline" with no explanation.
local function reportToBot()
	local httpRequest = (syn and syn.request) or (http and http.request) or http_request or request
	if not httpRequest then
		warn("[AccountReporter] No HTTP request function available in this executor - can't report to bot.")
		return false
	end

	local requestOk, response = pcall(function()
		return httpRequest({
			Url = BOT_REPORT_URL,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode({
				secret = REPORT_SECRET,
				userId = player.UserId,     -- stable identity - never changes even if the account is renamed
				playerName = player.Name,   -- real Roblox username, shown on the bot's Status panel
				placeId = game.PlaceId,
				jobId = game.JobId,
				gameName = cachedGameName,
				intervalSeconds = REPORT_INTERVAL,
			}),
		})
	end)

	if not requestOk then
		warn("[AccountReporter] Report request errored: " .. tostring(response))
		return false
	end

	local status = response and response.StatusCode
	local accepted = response and response.Success ~= false and (not status or (status >= 200 and status < 300))
	if not accepted then
		local reason = (response and response.Body) or (response and response.StatusMessage) or "no response body"
		warn(string.format(
			"[AccountReporter] Bot rejected the report (status %s): %s - check REPORT_SECRET matches the bot's, and that BOT_REPORT_URL is correct.",
			tostring(status), tostring(reason)
		))
		return false
	end

	return true
end

-- Event-driven note: teleporting to a different place or server destroys
-- and re-runs this ENTIRE script from scratch in the new place, so
-- game.JobId/game.PlaceId can never actually change while one script
-- instance is alive - and the loop below already reports immediately on
-- its very first iteration, so a teleport already gets an instant report
-- for free with zero extra code. The JobId/PlaceId check below is kept
-- anyway as cheap defensive code in case that ever isn't true for some
-- executor/framework. The one real mid-session event that does NOT
-- restart the script is a character respawn (death, or a soft "rejoin"
-- some games do without a full teleport) - CharacterAdded below reports
-- immediately on that, instead of waiting up to REPORT_INTERVAL.
local pendingImmediateReport = false
local lastJobId = game.JobId
local lastPlaceId = game.PlaceId

player.CharacterAdded:Connect(function()
	pendingImmediateReport = true
end)

task.spawn(function()
	local lastReportedAt = 0
	local nextJitter = math.random(0, JITTER_SECONDS * 100) / 100

	while true do
		local jobOrPlaceChanged = (game.JobId ~= lastJobId) or (game.PlaceId ~= lastPlaceId)
		local dueForTimer = (os.clock() - lastReportedAt) >= (REPORT_INTERVAL + nextJitter)

		if jobOrPlaceChanged or dueForTimer or pendingImmediateReport then
			if reportToBot() then
				lastReportedAt = os.clock()
				lastJobId = game.JobId
				lastPlaceId = game.PlaceId
				pendingImmediateReport = false
				nextJitter = math.random(0, JITTER_SECONDS * 100) / 100 -- re-roll jitter for the next cycle
			end
		end

		task.wait(CHANGE_POLL_SECONDS)
	end
end)
