local BOT_REPORT_URL = "https://divine-souls-bot.onrender.com" -- your bot's public URL
local REPORT_SECRET = "K9mP2xR7vL4qW8nJ3tY6hB1cF5zA0eD" -- must match the bot's REPORT_SECRET
local ACCOUNT_LABEL = "Souls" -- change per account, e.g. "Alt1", "Alt2"

local function reportToBot()
	local httpRequest = (syn and syn.request) or (http and http.request) or http_request or request
	if not httpRequest then return end

	local ok, gameName = pcall(function()
		return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name
	end)

	pcall(function()
		httpRequest({
			Url = BOT_REPORT_URL,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = game:GetService("HttpService"):JSONEncode({
				secret = REPORT_SECRET,
				label = ACCOUNT_LABEL,
				placeId = game.PlaceId,
				jobId = game.JobId,
				gameName = ok and gameName or "Unknown",
				intervalSeconds = 60, -- how often this account reports in
			}),
		})
	end)
end

task.spawn(function()
	while true do
		reportToBot()
		task.wait(60)
	end
end)
